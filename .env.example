# PACE SETTERS 2026 Environment Configuration
# Copy this file to .env.local and fill in your Supabase credentials:

# Your Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://ibnxjgkmmkcszntknroh.supabase.co

# Your Supabase Public Anon Key (JWT format starting with eyJhbGciOiJIUzI1NiIsIn...)
# Located in: Supabase Dashboard > Project Settings > API > Project API Keys > "anon" "public"
# NOTE: Do NOT use the secret service-role key on the client!
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
